{
  "bar": {
    "height": 32,
    "bottom": false,
    "font": "JetBrainsMono Nerd Font",
    "fontSize": 14,
    "iconSize": 14,
    "autohide": false,
    "workspaces": { "display": "dots" },
    "indicators": {
      "battery": true,
      "network": true,
      "cpu": true,
      "memory": true
    },
    "media": { "enabled": true },
    "tray": { "enabled": true }
  },
  "appearance": {
    "transparency": 0.96,
    "animationDuration": 200
  },
  "audio": {
    "maxAllowed": 100,
    "step": 0.05
  },
  "battery": {
    "low": 20,
    "critical": 10
  },
  "time": {
    "format": "HH:mm"
  },
  "notifications": {
    "timeout": 3000,
    "maxVisible": 3
  }
}
